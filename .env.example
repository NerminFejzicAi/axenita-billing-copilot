# =============================================================================
# Root environment example — LOCAL DEVELOPMENT ONLY
# =============================================================================
# Copy to `.env` (never commit `.env`, see .gitignore and 10 §3).
#
# Every value in this file is a placeholder for a local Docker Compose stack.
# It contains NO real secret and MUST NOT be reused for staging or production
# (09 §9: secrets never live in Git or in `.env.example`).
# Production values come from a secrets manager (00 §12).
# =============================================================================

COMPOSE_PROJECT_NAME=axenita-copilot

# -----------------------------------------------------------------------------
# PostgreSQL 16 (D-003)
# -----------------------------------------------------------------------------
# The container superuser is the migration owner role (00 §6.1, 10 §6).
# The runtime role `copilot_app` is created by the phase 2 init SQL and is NOT
# provisioned by this file.
POSTGRES_DB=copilot
POSTGRES_USER=copilot_migrator
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5432

# Isolated test database instance (08 §3 — test credentials are never dev/prod
# credentials, and destructive integration tests never touch the dev database).
POSTGRES_TEST_DB=copilot_test
POSTGRES_TEST_USER=copilot_test
POSTGRES_TEST_PASSWORD=local_test_only_change_me
POSTGRES_TEST_PORT=5433

# -----------------------------------------------------------------------------
# Redis 7 (00 §4.3)
# -----------------------------------------------------------------------------
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MinIO — local S3-compatible object storage (00 §4.4)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=copilot_local_dev
MINIO_ROOT_PASSWORD=local_dev_only_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
