// Prisma schema — Auditabilni Axenita TARDOC Billing Safety Copilot
//
// Normative sources: D-004 (Prisma 7 + custom SQL), `02_DATABASE_SCHEMA_V1.md` §26.
//
// Scope note: this schema declares two domains.
//
//   * PHASE 3 — the identity and practice domain owned by migration package
//     `002_identity_and_practices` (§22.2): `practices`, `users`, `practice_memberships`,
//     `practice_membership_roles`, `practice_settings`, `platform_role_assignments` and the
//     three enums they use;
//   * PHASE 5 — the patient, encounter, storage and document domain owned by migration
//     package `003_patient_encounter_documents` (§22.3, §29): `patient_references`,
//     `encounters`, `encounter_diagnoses`, `storage_objects`, `encounter_documents` and the
//     five enums they use;
//   * PHASE 5, SECOND SLICE — the two system tables owned by the phase 5 slice of migration
//     package `011_jobs_idempotency_outbox_audit` (§22.11, §29.9; D-064 `OD-5`):
//     `idempotency_keys` and `audit_events`. Exactly two models, no enum.
//
// Tables of packages `004` and later still belong to their own phases and are deliberately
// NOT declared here; declaring them early would pull later scope forward. `outbox_events`
// and `async_jobs` are the other two §15 tables of package `011` and are deliberately
// ABSENT: phase 5 has no consumer for either, so D-062 `OD-P5-D2-1`, D-063 clause 3 and
// D-064 `OD-5` all keep them out. `OutboxEvent` and `AsyncJob` must NOT be added here.
//
// Rules that Prisma cannot express and that therefore live in migration SQL (§26):
//   - RLS policies, grants, functions, triggers;
//   - some composite foreign keys;
//   - CHECK constraints;
//   - `NULLS NOT DISTINCT` (§26.2).
// `prisma migrate diff` may report drift on those objects. That is expected and must not
// be "fixed" by removing them (§26.2).
//
// Identifier rule (§2.2, §26.1): `@default(uuid())` is never used for business entities.
// The application generates every UUID and supplies it in the `create` call, because the
// canonical AAD of the encryption envelope (§2.7) contains `row_id`.

datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

// =============================================================================
// Enums (§4)
// =============================================================================

/// Practice and user lifecycle status (§4.2).
///
/// One shared type for both tables: §4.2 declares a single value set titled "Status
/// ordinacije/korisnika", and §6.1/§6.2 both point at it. The physical type name is
/// `entity_status`; §4.2 fixes the values but not the name, so the name is a naming
/// resolution recorded by the phase 3 implementation authorisation, not a new decision.
enum EntityStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED

  @@map("entity_status")
}

/// Tenant application roles, valid inside exactly one practice (§4.1).
///
/// Exactly six values. Assignments live in `practice_membership_roles` (§6.3a), never as a
/// singular column on `practice_memberships` (D-038 clause 2). `SYSTEM_ADMIN` is a platform
/// role and must never appear here (D-038 clause 12).
enum MembershipRole {
  PRACTICE_ADMIN
  PHYSICIAN
  MPA
  BILLING_SPECIALIST
  AUDITOR
  READ_ONLY

  @@map("membership_role")
}

/// Platform application role (§4.16).
///
/// Separate from `membership_role` (D-023 clause 8). A platform role alone grants no tenant
/// permission at all (D-038 clause 13).
enum PlatformRole {
  SYSTEM_ADMIN

  @@map("platform_role")
}

// =============================================================================
// Identity and tenant tables (§6)
// =============================================================================

/// A medical practice — the tenant (§6.1).
///
/// Runtime access is bootstrap-scoped: `ENABLE` + `FORCE RLS` with a PERMISSIVE membership
/// policy and a RESTRICTIVE context-narrowing policy (§17.6), plus a column-level SELECT
/// grant that deliberately excludes `legal_name`, `zsr_number` and `gln_number` (§20.2a).
/// Those three columns therefore exist here but are unreachable for `copilot_app`.
model Practice {
  id              String       @id @db.Uuid
  code            String       @unique(map: "practices_code_key") @db.VarChar(50)
  name            String       @db.VarChar(255)
  legalName       String?      @map("legal_name") @db.VarChar(255)
  zsrNumber       String?      @map("zsr_number") @db.VarChar(50)
  glnNumber       String?      @map("gln_number") @db.VarChar(50)
  defaultLanguage String       @default("de-CH") @map("default_language") @db.VarChar(10)
  timezone        String       @default("Europe/Zurich") @db.VarChar(100)
  status          EntityStatus
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships PracticeMembership[]
  settings    PracticeSettings?

  // Phase 5 back-relations (§29.2 rows 1 and 5). Prisma-only: the foreign keys live on the
  // CHILD tables, so these fields emit no SQL and change nothing about `practices`.
  patientReferences PatientReference[]
  storageObjects    StorageObject[]

  // Phase 5 slice of package `011` (§29.9.1; D-064 `OD-4`, `OD-5`). Prisma-only back-relations
  // for the two — and ONLY two — new `practices` foreign keys. Like the two above they live on
  // the CHILD tables and therefore emit NO structural change against `practices`: no column, no
  // index, no constraint is added here (D-064 `OD-5`).
  idempotencyKeys IdempotencyKey[]
  auditEvents     AuditEvent[]

  @@index([status], map: "practices_status_idx")
  @@map("practices")
}

/// An authenticated human user (§6.2).
///
/// No password and no password hash: authentication is OIDC/JWT in production and a
/// controlled development mechanism otherwise (09 §5). `auth_subject` is readable only
/// through the RLS policy expression of §17.5 — `copilot_app` has no column grant on it, so
/// an application level `SELECT` or `WHERE` on it fails with SQLSTATE 42501 (§20.2a).
model User {
  id                String       @id @db.Uuid
  authSubject       String       @unique(map: "users_auth_subject_key") @map("auth_subject") @db.VarChar(255)
  email             String       @db.VarChar(320)
  displayName       String       @map("display_name") @db.VarChar(255)
  preferredLanguage String       @map("preferred_language") @db.VarChar(10)
  status            EntityStatus
  lastLoginAt       DateTime?    @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships             PracticeMembership[]
  platformRoleAssignments PlatformRoleAssignment[]

  @@map("users")
}

/// Membership of one user in one practice (§6.3).
///
/// D-038 clause 2: this table has **no** singular `role` column and **no**
/// `(practice_id, active, role)` index. Role assignment lives in
/// `practice_membership_roles`. `active` is the only membership lifecycle flag, and it is
/// owned here — the assignment table must never grow its own.
///
/// `unique (practice_id, id)` is both the unconditional tenant constraint of §2.5 and the
/// parent key of the composite foreign key declared by `practice_membership_roles`.
model PracticeMembership {
  id              String   @id @db.Uuid
  practiceId      String   @map("practice_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  professionalGln String?  @map("professional_gln") @db.VarChar(50)
  active          Boolean
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Referential actions are pinned to `NO ACTION` — PostgreSQL's default — because §6.3
  // declares none. Prisma would otherwise emit `ON DELETE RESTRICT ON UPDATE CASCADE`,
  // which is an invented rule (§28.1 tracks referential actions as an open question).
  practice Practice                 @relation(fields: [practiceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "practice_memberships_practice_fk")
  user     User                     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "practice_memberships_user_fk")
  roles    PracticeMembershipRole[]

  // Phase 5 back-relation (§29.2 row 3). Prisma-only: the foreign key
  // `encounters_responsible_physician_membership_fk` is created ON `encounters`, and the
  // parent key `practice_memberships_practice_user_key` already exists from package `002`.
  // NO index and NO constraint is added to `practice_memberships` by package `003`
  // (D-061 clause 11, D-062 Dio B.4).
  responsibleForEncounters Encounter[]

  @@unique([practiceId, userId], map: "practice_memberships_practice_user_key")
  @@unique([practiceId, id], map: "practice_memberships_tenant_key")
  @@index([userId, active], map: "practice_memberships_user_active_idx")
  @@map("practice_memberships")
}

/// Current tenant role assignments of a membership (§6.3a, D-038).
///
/// Lifecycle (D-038 clauses 25–32): the table stores **only currently effective**
/// assignments. Removing a role deletes its row; re-assigning later inserts a new row. The
/// unique triple stays non-partial precisely because deletion frees it. Assignment history
/// belongs to immutable audit evidence, never to retained revoked rows — hence no
/// `revoked_at`, `revoked_by`, `active`, `valid_from` or `valid_to` here.
///
/// The composite foreign key `(practice_id, membership_id)` makes a cross-practice
/// assignment structurally impossible (D-038 clause 19). No separate
/// `practice_id -> practices(id)` foreign key is declared: §22.2 enumerates exactly three
/// constraints for this table, and the composite key already carries `practice_id` into a
/// parent that is itself keyed to `practices`. Referential actions are deliberately not
/// declared, so PostgreSQL applies `NO ACTION`; §28.1 tracks that as an open question.
model PracticeMembershipRole {
  id           String         @id @db.Uuid
  practiceId   String         @map("practice_id") @db.Uuid
  membershipId String         @map("membership_id") @db.Uuid
  role         MembershipRole
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership PracticeMembership @relation(fields: [practiceId, membershipId], references: [practiceId, id], onDelete: NoAction, onUpdate: NoAction, map: "practice_membership_roles_membership_fk")

  @@unique([practiceId, id], map: "practice_membership_roles_tenant_key")
  @@unique([practiceId, membershipId, role], map: "practice_membership_roles_membership_role_key")
  @@map("practice_membership_roles")
}

/// Exactly one settings row per practice (§6.4).
///
/// Both approval flags default to `false`: approval outside `PHYSICIAN`/`PRACTICE_ADMIN` is
/// an opt-in decision of the practice, never a default state (D-041). `version` is the
/// optimistic locking column of D-029 and is guarded by a CHECK constraint that lives in
/// migration SQL because Prisma cannot express it.
///
/// The table carries no `created_at`: §6.4 declares `updated_at` only.
model PracticeSettings {
  id                             String   @id @db.Uuid
  practiceId                     String   @unique(map: "practice_settings_practice_key") @map("practice_id") @db.Uuid
  billingReviewRequired          Boolean  @map("billing_review_required")
  allowMpaApproval               Boolean  @default(false) @map("allow_mpa_approval")
  allowBillingSpecialistApproval Boolean  @default(false) @map("allow_billing_specialist_approval")
  requireReasonForManualChange   Boolean  @map("require_reason_for_manual_change")
  aiEnabled                      Boolean  @map("ai_enabled")
  axenitaExportEnabled           Boolean  @map("axenita_export_enabled")
  retentionPolicyCode            String?  @map("retention_policy_code") @db.VarChar(100)
  configuration                  Json     @db.JsonB
  version                        Int      @default(1)
  updatedBy                      String?  @map("updated_by") @db.Uuid
  updatedAt                      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "practice_settings_practice_fk")

  @@unique([practiceId, id], map: "practice_settings_tenant_key")
  @@map("practice_settings")
}

/// Platform role assignment (§6.5).
///
/// A global table: it has no `practice_id` and is not a tenant table. `SYSTEM_ADMIN` is
/// never derived from a membership role, and a `SYSTEM_ADMIN` without an active membership
/// reaches no tenant data at all (D-023 clauses 8–12). Writes are seed/migration only in the
/// MVP.
///
/// `granted_by` and `revoked_by` are plain uuid columns: §6.5 declares a foreign key for
/// `user_id` only, and inventing two more would widen the accepted constraint set.
model PlatformRoleAssignment {
  id           String       @id @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  platformRole PlatformRole @map("platform_role")
  grantedBy    String?      @map("granted_by") @db.Uuid
  grantedAt    DateTime     @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt    DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedBy    String?      @map("revoked_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "platform_role_assignments_user_fk")

  @@unique([userId, platformRole], map: "platform_role_assignments_user_role_key")
  @@index([userId], map: "platform_role_assignments_user_idx")
  @@map("platform_role_assignments")
}

// =============================================================================
// Phase 5 enums (§4.3–§4.8, §29.1; D-062 Dio B.1)
//
// Created by migration package `003_patient_encounter_documents` and by nothing else
// (§22.3). Every value set is FROZEN by §4.3–§4.8 — no value is added, removed or renamed
// here. Physical names follow the §2.1 + §22.2 precedent (`entity_status`,
// `membership_role`, `platform_role`): snake_case singular, `@@map`-ed.
//
// The two phase 5 document status vocabularies — `processing_status` and `redaction_status`
// — are DELIBERATELY NOT enums. §2.11.4 and D-062 Dio E keep both columns `varchar(30)` and
// enforce the vocabulary with named CHECK constraints instead; D-060 clause 44 forbids
// changing the column type.
// =============================================================================

/// Origin of an externally sourced record (§4.6 — FROZEN).
enum IntegrationProvider {
  AXENITA
  MANUAL
  CSV
  FHIR
  OTHER

  @@map("integration_provider")
}

/// Encounter lifecycle state (§4.3 — FROZEN; the canonical state machine is `03` §29.1 /
/// D-027, and phase 5 reaches exactly 4 of its 15 transitions — D-062 Dio F.1).
enum EncounterStatus {
  DRAFT
  READY_FOR_ANALYSIS
  ANALYSIS_IN_PROGRESS
  REVIEW_REQUIRED
  APPROVED
  EXPORT_PENDING
  EXPORTED
  CANCELLED
  CLOSED

  @@map("encounter_status")
}

/// Human review state of a derived item (§4.8 — FROZEN).
enum ReviewState {
  UNREVIEWED
  CONFIRMED
  CORRECTED
  REJECTED

  @@map("review_state")
}

/// Kind of clinical document (§4.4 — FROZEN).
enum DocumentType {
  CONSULTATION_NOTE
  DIAGNOSIS_LIST
  PROCEDURE_NOTE
  REFERRAL
  LAB_RESULT
  BILLING_DRAFT
  AUDIT_REPORT
  OTHER

  @@map("document_type")
}

/// How a document entered the system (§4.5 — FROZEN).
enum DocumentSource {
  MANUAL_TEXT
  FILE_UPLOAD
  AXENITA_API
  CSV_IMPORT
  FHIR_IMPORT
  GENERATED

  @@map("document_source")
}

// =============================================================================
// Phase 5 patient, encounter, storage and document tables (§7.1–§7.3, §8.1, §8.2, §29)
//
// Owned by package `003_patient_encounter_documents`. THAT PACKAGE ISSUES NO GRANT AND
// CREATES NO RLS OBJECT (§22.3, D-062 Dio B.3, D-063 clause 2): after `003` alone these five
// tables are reachable by NO runtime role at all, which is what makes the window between
// migrations carry zero capability rather than merely a short exposure.
//
// Referential actions: EVERY phase 5 relation pins `onDelete: NoAction, onUpdate: NoAction`
// literally (§29.3, D-062 Dio C.4). Prisma would otherwise silently substitute
// `Restrict`/`Cascade`, an invented rule that migration `002` already rejected. The three
// mixed-nullability composite keys (#3, #7, #8 of §29.2) rely on PostgreSQL's default
// `MATCH SIMPLE`, which Prisma emits: `MATCH FULL` would reject "no responsible physician"
// and "no storage object" and must NEVER be used here.
//
// Identifier rule (§2.2, §26.1): no `@default(uuid())` anywhere — the application generates
// every UUID because the canonical AAD of the encryption envelope contains `row_id`. The
// only defaults are `created_at` and `encounters.version` (D-062 Dio B.1).
//
// CHECK constraints cannot be expressed in Prisma and therefore live in the migration SQL
// (§26). All 23 of them carry an explicit canonical name (§29.7a, D-063 clause 7).
// =============================================================================

/// Pseudonymous reference to a patient held in the source system (§7.1).
///
/// `external_patient_ref_hash` is a KEYED deterministic lookup token — HMAC-SHA256 under a
/// dedicated `K_hmac`, persisted as `h1.<64 hex>` (§2.8, D-060). NO HMAC key-version column
/// exists: the generation marker lives inside the token. `pseudonym` is CSPRNG-derived and
/// never derived from the external identifier (§2.9); NO `citext` column, functional index or
/// special collation is introduced. The envelope columns stay unwritten in phase 5 —
/// write-back sits behind `D-OPEN-009` (§29.8).
model PatientReference {
  id                           String              @id @db.Uuid
  practiceId                   String              @map("practice_id") @db.Uuid
  sourceSystem                 IntegrationProvider @map("source_system")
  externalPatientRefHash       String              @map("external_patient_ref_hash") @db.VarChar(128)
  externalPatientRefCiphertext Bytes?              @map("external_patient_ref_ciphertext")
  externalPatientRefIv         Bytes?              @map("external_patient_ref_iv")
  externalPatientRefAuthTag    Bytes?              @map("external_patient_ref_auth_tag")
  encryptionAlgorithm          String?             @map("encryption_algorithm") @db.VarChar(30)
  encryptionVersion            Int?                @map("encryption_version")
  encryptionKeyRef             String?             @map("encryption_key_ref") @db.VarChar(255)
  encryptionKeyVersion         Int?                @map("encryption_key_version")
  pseudonym                    String              @db.VarChar(50)
  birthYear                    Int?                @map("birth_year") @db.SmallInt
  sexCode                      String?             @map("sex_code") @db.VarChar(20)
  createdAt                    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  practice   Practice    @relation(fields: [practiceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "patient_references_practice_fk")
  encounters Encounter[]

  @@unique([practiceId, sourceSystem, externalPatientRefHash], map: "patient_references_source_external_ref_key")
  @@unique([practiceId, pseudonym], map: "patient_references_pseudonym_key")
  @@unique([practiceId, id], map: "patient_references_tenant_key")
  @@map("patient_references")
}

/// One treatment episode (§7.2).
///
/// NO direct `practice_id -> practices(id)` foreign key is declared: the tenant key is
/// carried TRANSITIVELY through `encounters_patient_reference_fk` into
/// `patient_references_practice_fk`, and a second key would duplicate the same guarantee
/// (§29.2, precedent §6.3a). `created_by`/`updated_by` are application invariants, not
/// foreign keys (precedent §6.5). `responsible_physician_id` gets NO direct key to `users`
/// either — the membership key already guarantees the user exists.
///
/// `encounters_responsible_physician_membership_fk` is the database half of D-062 Dio D: a
/// responsible physician must be a member OF THIS PRACTICE, proven structurally rather than
/// by a query the caller is not privileged to run. It is `MATCH SIMPLE` because
/// `practice_id` is NOT NULL while `responsible_physician_id` is nullable.
/// **Its behaviour under FORCE RLS is NOT proven by this package — that is the `★` proof of
/// slice `P5-I2`, which stays a hard precondition of `P5-I5` (D-062 Dio D.6).**
///
/// `version` is the D-029 optimistic locking column. Phase 5 writes NO ciphertext into this
/// table at all — every `external_encounter_ref_*` and `encryption_*` column stays NULL by
/// design (§29.8). There is no `reason` column and no `archived_at` column.
model Encounter {
  id                             String              @id @db.Uuid
  practiceId                     String              @map("practice_id") @db.Uuid
  patientReferenceId             String              @map("patient_reference_id") @db.Uuid
  externalEncounterRefHash       String?             @map("external_encounter_ref_hash") @db.VarChar(128)
  externalEncounterRefCiphertext Bytes?              @map("external_encounter_ref_ciphertext")
  externalEncounterRefIv         Bytes?              @map("external_encounter_ref_iv")
  externalEncounterRefAuthTag    Bytes?              @map("external_encounter_ref_auth_tag")
  encryptionAlgorithm            String?             @map("encryption_algorithm") @db.VarChar(30)
  encryptionVersion              Int?                @map("encryption_version")
  encryptionKeyRef               String?             @map("encryption_key_ref") @db.VarChar(255)
  encryptionKeyVersion           Int?                @map("encryption_key_version")
  occurredAt                     DateTime            @map("occurred_at") @db.Timestamptz(6)
  treatmentDate                  DateTime            @map("treatment_date") @db.Date
  responsiblePhysicianId         String?             @map("responsible_physician_id") @db.Uuid
  guarantorType                  String?             @map("guarantor_type") @db.VarChar(30)
  insuranceContext               String?             @map("insurance_context") @db.VarChar(30)
  specialtyCode                  String?             @map("specialty_code") @db.VarChar(50)
  patientAgeAtEncounter          Int?                @map("patient_age_at_encounter") @db.SmallInt
  patientSexAtEncounter          String?             @map("patient_sex_at_encounter") @db.VarChar(20)
  status                         EncounterStatus
  sourceSystem                   IntegrationProvider @map("source_system")
  version                        Int                 @default(1)
  createdBy                      String              @map("created_by") @db.Uuid
  createdAt                      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy                      String?             @map("updated_by") @db.Uuid
  updatedAt                      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  patientReference     PatientReference    @relation(fields: [practiceId, patientReferenceId], references: [practiceId, id], onDelete: NoAction, onUpdate: NoAction, map: "encounters_patient_reference_fk")
  responsiblePhysician PracticeMembership? @relation(fields: [practiceId, responsiblePhysicianId], references: [practiceId, userId], onDelete: NoAction, onUpdate: NoAction, map: "encounters_responsible_physician_membership_fk")

  diagnoses EncounterDiagnosis[]
  documents EncounterDocument[]

  @@unique([practiceId, id], map: "encounters_tenant_key")
  @@index([practiceId, status, treatmentDate(sort: Desc), id(sort: Desc)], map: "encounters_review_queue_idx")
  @@index([practiceId, patientReferenceId, treatmentDate(sort: Desc), id(sort: Desc)], map: "encounters_patient_timeline_idx")
  @@index([practiceId, responsiblePhysicianId, treatmentDate(sort: Desc), id(sort: Desc)], map: "encounters_responsible_physician_idx")
  @@map("encounters")
}

/// A diagnosis recorded on an encounter (§7.3).
///
/// This table carries NO CHECK constraint at all. That is a RATIFIED ABSENCE, not an omission
/// (§29.7a, D-063 clause 7): its constraints are the primary key, two uniques and the
/// composite foreign key. It also carries no `updated_at` — §7.3 declares `created_at` only.
model EncounterDiagnosis {
  id            String      @id @db.Uuid
  practiceId    String      @map("practice_id") @db.Uuid
  encounterId   String      @map("encounter_id") @db.Uuid
  codingSystem  String      @map("coding_system") @db.VarChar(30)
  diagnosisCode String      @map("diagnosis_code") @db.VarChar(50)
  description   String?
  diagnosisType String?     @map("diagnosis_type") @db.VarChar(30)
  isPrimary     Boolean     @map("is_primary")
  source        String      @db.VarChar(30)
  reviewState   ReviewState @map("review_state")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  encounter Encounter @relation(fields: [practiceId, encounterId], references: [practiceId, id], onDelete: NoAction, onUpdate: NoAction, map: "encounter_diagnoses_encounter_fk")

  @@unique([practiceId, id], map: "encounter_diagnoses_tenant_key")
  @@unique([practiceId, encounterId, codingSystem, diagnosisCode], map: "encounter_diagnoses_encounter_code_key")
  @@map("encounter_diagnoses")
}

/// A blob held in object storage (§8.1).
///
/// `encryption_key_ref` and `encryption_version` here describe encryption of the BLOB in
/// object storage. They are NOT part of the §2.7 row envelope and carry none of its CHECK
/// constraints; the table has no `*_ciphertext` column at all (§8.1).
///
/// Phase 5 gives this table NO capability whatsoever — no grant, no policy, and no route
/// reads or writes it (§29.5). It exists because it is a foreign key parent, and it holds
/// zero rows.
model StorageObject {
  id                   String    @id @db.Uuid
  practiceId           String    @map("practice_id") @db.Uuid
  bucketName           String    @map("bucket_name") @db.VarChar(100)
  objectKey            String    @map("object_key") @db.VarChar(500)
  contentType          String    @map("content_type") @db.VarChar(150)
  originalFilename     String?   @map("original_filename") @db.VarChar(255)
  byteSize             BigInt    @map("byte_size")
  sha256               String    @db.VarChar(64)
  encryptionKeyRef     String?   @map("encryption_key_ref") @db.VarChar(255)
  encryptionVersion    Int?      @map("encryption_version")
  antivirusStatus      String?   @map("antivirus_status") @db.VarChar(30)
  createdBy            String    @map("created_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt           DateTime? @map("archived_at") @db.Timestamptz(6)
  retentionDeleteAfter DateTime? @map("retention_delete_after") @db.Timestamptz(6)

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "storage_objects_practice_fk")

  documents       EncounterDocument[] @relation("EncounterDocumentStorageObject")
  sourceDocuments EncounterDocument[] @relation("EncounterDocumentSourceStorageObject")

  @@unique([bucketName, objectKey], map: "storage_objects_bucket_object_key")
  @@unique([practiceId, id], map: "storage_objects_tenant_key")
  @@map("storage_objects")
}

/// A clinical document attached to an encounter (§8.2).
///
/// `normalized_text_*` holds the ENCRYPTED, canonically normalised, UNREDACTED source text.
/// The raw pre-normalisation text is NEVER persisted and HAS NO COLUMN (§2.10.1, D-060);
/// there is no second hash column for the raw input, and no per-document redaction-ruleset
/// version column (§2.11.3). `redacted_text_*` stays Class A medical data — phase 5
/// redaction is neither anonymisation nor de-identification.
///
/// `processing_status` and `redaction_status` stay `varchar(30)`. Converting them to
/// PostgreSQL enums is NOT authorised (§2.11.4, D-060 clause 44). Their vocabularies —
/// `READY`/`FAILED` and `COMPLETED`/`FAILED` — are enforced by two named CHECK constraints,
/// and a third CHECK ties `COMPLETED` to the presence of the redacted artifact and `FAILED`
/// to its absence (D-062 Dio E). `PENDING`, `PROCESSING`, `ARCHIVED` and `SKIPPED` do not
/// exist; archiving carries `archived_at`.
///
/// Two relations point at `StorageObject`, so both carry an explicit, distinct relation name.
/// Both are nullable composite keys and therefore `MATCH SIMPLE`.
model EncounterDocument {
  id                       String         @id @db.Uuid
  practiceId               String         @map("practice_id") @db.Uuid
  encounterId              String         @map("encounter_id") @db.Uuid
  documentType             DocumentType   @map("document_type")
  source                   DocumentSource
  storageObjectId          String?        @map("storage_object_id") @db.Uuid
  sourceStorageObjectId    String?        @map("source_storage_object_id") @db.Uuid
  normalizedTextCiphertext Bytes?         @map("normalized_text_ciphertext")
  normalizedTextIv         Bytes?         @map("normalized_text_iv")
  normalizedTextAuthTag    Bytes?         @map("normalized_text_auth_tag")
  redactedTextCiphertext   Bytes?         @map("redacted_text_ciphertext")
  redactedTextIv           Bytes?         @map("redacted_text_iv")
  redactedTextAuthTag      Bytes?         @map("redacted_text_auth_tag")
  encryptionAlgorithm      String?        @map("encryption_algorithm") @db.VarChar(30)
  encryptionVersion        Int?           @map("encryption_version")
  encryptionKeyRef         String?        @map("encryption_key_ref") @db.VarChar(255)
  encryptionKeyVersion     Int?           @map("encryption_key_version")
  sourceTextHash           String?        @map("source_text_hash") @db.VarChar(64)
  redactedTextHash         String?        @map("redacted_text_hash") @db.VarChar(64)
  languageCode             String?        @map("language_code") @db.VarChar(10)
  pageCount                Int?           @map("page_count")
  processingStatus         String         @map("processing_status") @db.VarChar(30)
  redactionStatus          String         @map("redaction_status") @db.VarChar(30)
  externalDocumentRefHash  String?        @map("external_document_ref_hash") @db.VarChar(128)
  createdBy                String         @map("created_by") @db.Uuid
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt               DateTime?      @map("archived_at") @db.Timestamptz(6)

  encounter           Encounter      @relation(fields: [practiceId, encounterId], references: [practiceId, id], onDelete: NoAction, onUpdate: NoAction, map: "encounter_documents_encounter_fk")
  storageObject       StorageObject? @relation("EncounterDocumentStorageObject", fields: [practiceId, storageObjectId], references: [practiceId, id], onDelete: NoAction, onUpdate: NoAction, map: "encounter_documents_storage_object_fk")
  sourceStorageObject StorageObject? @relation("EncounterDocumentSourceStorageObject", fields: [practiceId, sourceStorageObjectId], references: [practiceId, id], onDelete: NoAction, onUpdate: NoAction, map: "encounter_documents_source_storage_object_fk")

  @@unique([practiceId, id], map: "encounter_documents_tenant_key")
  @@index([practiceId, encounterId, createdAt], map: "documents_encounter_idx")
  @@map("encounter_documents")
}

// =============================================================================
// System tables — phase 5 slice of package `011_jobs_idempotency_outbox_audit`
// (§15.2, §15.4, §22.11, §29.9; D-023, D-062 `OD-P5-D2-1`, D-063 clause 3, D-064)
// =============================================================================
//
// EXACTLY TWO MODELS. `OutboxEvent` and `AsyncJob` are the other two §15 tables this package
// owns and are deliberately NOT declared: phase 5 has no consumer for either, so their slice
// stays deferred (D-064 `OD-5`). Declaring them here would pull later scope forward.
//
// ZERO RUNTIME CAPABILITY (D-064 `OD-1`). The phase 5 slice of package `011` is STRUCTURAL
// ONLY. It issues no `GRANT`, no `REVOKE`, no `ENABLE`/`FORCE` RLS statement and no
// policy; after it, and before the phase 5 slice of `013_rls_policies`, both tables carry
// `relrowsecurity = false`, `relforcerowsecurity = false`, zero policies and zero runtime
// grants. That state is SAFE AND INTENDED — the tables are owned by `copilot_migrator`, no
// `DEFAULT PRIVILEGE` exists on schema `public`, and neither runtime role holds `CREATE`
// there, so no runtime role can reach them at all. Grants, RLS and the five policies of
// §29.4a arrive together, in ONE transaction, with package `013` (D-049 clause 5).
//
// EXACTLY TWO NEW FOREIGN KEYS (§29.9.1, D-064 `OD-4`), both to `practices(id)` and both with
// referential actions pinned explicitly to `NoAction`/`NoAction` — Prisma would otherwise
// substitute `Restrict`/`Cascade` (§29.3). NO key to `users` is declared from either table:
// `idempotency_keys.user_id`, `audit_events.actor_user_id` and `audit_events.actor_service`
// stay APPLICATION INVARIANTS (precedent §6.5), because a key to `users` would introduce an
// identity relation D-061 explicitly does not widen.
//
// Identifier rule (§2.2, §26.1): no `@default(uuid())`. The only default in either model is
// `idempotency_keys.created_at`, matching every other `created_at` in this schema. §15.4
// declares NO `created_at` on `audit_events` — `occurred_at` is the event timestamp and
// carries no default, exactly like `encounters.occurred_at`.

/// One recorded idempotent command execution (§15.2).
///
/// The scope key `(practice_id, user_id, endpoint, idempotency_key)` is what makes a replayed
/// command resolve to the same recorded response inside one practice, one user and one
/// endpoint; `(practice_id, id)` is the unconditional tenant constraint of §2.5 / D-022.
///
/// `response_body` must never hold medical content (§15.2). Only `response_status`,
/// `response_body`, `locked_at` and `completed_at` ever become mutable, through the
/// column-level `UPDATE` grant of §29.4a.3 — which belongs to package `013`, not here.
model IdempotencyKey {
  id             String    @id @db.Uuid
  practiceId     String    @map("practice_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key") @db.VarChar(255)
  endpoint       String    @db.VarChar(255)
  requestSha256  String    @map("request_sha256") @db.VarChar(64)
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "idempotency_keys_practice_fk")

  @@unique([practiceId, id], map: "idempotency_keys_tenant_key")
  @@unique([practiceId, userId, endpoint, idempotencyKey], map: "idempotency_keys_scope_key")
  @@map("idempotency_keys")
}

/// One append-only audit event (§15.4).
///
/// `practice_id` is `NOT NULL` (D-023 clause 1): under a FORCE RLS equality policy a nullable
/// tenant key would make `NULL = <uuid>` yield `NULL`, so the runtime role could neither write
/// nor read such a row — silently, without an error. No `system_audit_events` twin is created
/// (D-023 clause 2).
///
/// Append-only is enforced primarily by the GRANT — `SELECT` + `INSERT`, never `UPDATE`,
/// `DELETE` or `TRUNCATE` (§15.4, §29.4a.4, D-064 `OD-3`) — which belongs to package `013`.
/// The §19.2 audit guard trigger belongs to package `014`. Neither is declared here.
///
/// `previous_value` and `new_value` must be sanitised before they are written (§15.4);
/// `event_sha256` / `previous_event_sha256` carry the hash chain.
model AuditEvent {
  id                  String   @id @db.Uuid
  practiceId          String   @map("practice_id") @db.Uuid
  occurredAt          DateTime @map("occurred_at") @db.Timestamptz(6)
  actorType           String   @map("actor_type") @db.VarChar(30)
  actorUserId         String?  @map("actor_user_id") @db.Uuid
  actorService        String?  @map("actor_service") @db.VarChar(100)
  action              String   @db.VarChar(150)
  resourceType        String   @map("resource_type") @db.VarChar(100)
  resourceId          String?  @map("resource_id") @db.Uuid
  requestId           String?  @map("request_id") @db.VarChar(100)
  sessionIdHash       String?  @map("session_id_hash") @db.VarChar(128)
  ipAddress           String?  @map("ip_address") @db.Inet
  userAgentHash       String?  @map("user_agent_hash") @db.VarChar(128)
  previousValue       Json?    @map("previous_value")
  newValue            Json?    @map("new_value")
  metadata            Json
  eventSha256         String   @map("event_sha256") @db.VarChar(64)
  previousEventSha256 String?  @map("previous_event_sha256") @db.VarChar(64)

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "audit_events_practice_fk")

  // Both §21 audit indexes are created by THIS package's creator migration (§29.9.2,
  // D-064 `OD-7`). Package `012` may later verify or reconcile them; creation is not deferred,
  // because `012` does not exist in phase 5 and a table without its indexes is not finished.
  @@unique([practiceId, id], map: "audit_events_tenant_key")
  @@index([practiceId, resourceType, resourceId, occurredAt], map: "audit_resource_idx")
  @@index([practiceId, actorUserId, occurredAt(sort: Desc)], map: "audit_actor_idx")
  @@map("audit_events")
}
