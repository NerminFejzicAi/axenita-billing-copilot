# =============================================================================
# apps/api environment example — LOCAL DEVELOPMENT ONLY
# =============================================================================
# Copy to `apps/api/.env` (never commit `.env`, see 10 §3).
#
# Contains NO real secret. Every credential below is a placeholder that matches the
# local Docker Compose stack (09 §9: secrets never live in Git or in `.env.example`).
# Production configuration comes from the deployment environment and a secrets manager.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
API_HOST=127.0.0.1
LOG_LEVEL=log

# --- HTTP surface ------------------------------------------------------------
# Explicit CORS allowlist (09 §14). Comma separated; empty means no browser origin
# is allowed, which is the safe default.
API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Maximum accepted request body size (09 §14).
API_BODY_LIMIT=1mb

# Base URI for the `type` member of Problem Details documents (03 §8).
API_PROBLEM_TYPE_BASE_URL=https://api.example.ch/problems

# --- PostgreSQL --------------------------------------------------------------
# Runtime connection string — role `copilot_app` (02 §3.2, §3.4).
# This is the ONLY database credential the API process may read. `copilot_app` is
# NOBYPASSRLS, owns nothing, and holds only explicitly granted table privileges.
DATABASE_URL=postgresql://copilot_app:local_dev_only_change_me@localhost:5432/copilot

# Migration connection string — role `copilot_migrator` (02 §3.1, §3.4).
# Consumed by the Prisma CLI ONLY. The runtime application must never read this
# variable (02 §3.4, D-023 clause 6, AGENTS.md §5.2), which is why it is deliberately
# absent from the runtime environment schema in `src/config/environment.schema.ts`.
MIGRATION_DATABASE_URL=postgresql://copilot_migrator:local_dev_only_change_me@localhost:5432/copilot

# Platform/tariff write credential — role `copilot_system` (02 §3.3, §3.4, D-023).
# Declared here so the credential mapping of §3.4 is complete. No phase 2 code path
# uses it: the first system-scope write is tariff activation in phase 6, so it is
# deliberately absent from the runtime environment schema.
SYSTEM_DATABASE_URL=postgresql://copilot_system:local_dev_only_change_me@localhost:5432/copilot

# --- Isolated test database (08 §3) ------------------------------------------
# Consumed by the integration test harness only. Never the development credentials.
# Three identities are required because 08 §5.1 mandates privilege assertions per role.
TEST_DATABASE_URL=postgresql://copilot_app:local_test_only_change_me@localhost:5433/copilot_test
TEST_MIGRATION_DATABASE_URL=postgresql://copilot_migrator:local_test_only_change_me@localhost:5433/copilot_test
TEST_SYSTEM_DATABASE_URL=postgresql://copilot_system:local_test_only_change_me@localhost:5433/copilot_test

# --- Redis -------------------------------------------------------------------
# Queue and coordination only. Never medical content, never secrets (09 §16).
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible, local MinIO) ------------------------------
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_HEALTH_PATH=/minio/health/live

# --- Health ------------------------------------------------------------------
# Per-dependency timeout for the readiness probe, in milliseconds.
HEALTH_CHECK_TIMEOUT_MS=2000
